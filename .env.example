# Локальный файл SQLite; относительный путь считается от корня проекта.
DATABASE_URL=file:./data/grelqa.db

# Только origin; для production обязателен https://адрес-домена.
APP_URL=http://localhost:3000
# Публичный HTTP(S) origin для RSS/Atom. В production задайте реальный домен.
SITE_URL=http://localhost:3000
# Создайте секрет: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# local разрешён ТОЛЬКО при npm run dev. Для npm start требуется smtp.
MAIL_MODE=local
MAIL_DIRECTORY=.local/mail
MAIL_FROM=Grelqa <noreply@example.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# Приватный файловый кэш ZIP, путь от корня проекта либо абсолютный. Не public.
EXPORT_CACHE_DIRECTORY=.local/exports

# Публичный URL соответствующего исходного кода именно развёрнутой версии,
# включая локальные изменения, сборочные файлы и необходимые скрипты.
# Например, доступный без аккаунта архив/страница неизменяемого релиза.
# Не указывайте приватный репозиторий, credentials или произвольный upstream.
# Если пусто/некорректно, ссылка в подвале скрыта. Перед публичным запуском
# настройте предоставление соответствующего исходного кода по AGPL v3 §13.
SOURCE_CODE_URL=
