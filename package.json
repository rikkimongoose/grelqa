{
  "name": "grelqa",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=26.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --import tsx scripts/migrate.ts",
    "db:seed": "node --import tsx scripts/seed.ts",
    "test:db": "node --conditions=react-server --import tsx --test tests/database.test.ts",
    "test:pages": "node --import tsx --test tests/pages.test.ts",
    "test:auth": "node --conditions=react-server --import tsx --test tests/auth.test.ts"
  },
  "dependencies": {
    "@libsql/client": "0.18.0",
    "@node-rs/argon2": "2.2.2",
    "dotenv": "17.2.3",
    "drizzle-orm": "0.45.4",
    "iron-session": "9.0.1",
    "next": "16.4.3",
    "nodemailer": "10.3.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "drizzle-kit": "0.31.11",
    "eslint": "10.14.0",
    "eslint-config-next": "16.4.3",
    "tsx": "4.23.15",
    "typescript": "~5.9.3"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    }
  }
}
