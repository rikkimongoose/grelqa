[Unit]
Description=Grelqa scheduled contest transitions (one pass)
After=local-fs.target

[Service]
Type=oneshot
User=grelqa
Group=grelqa
WorkingDirectory=/srv/grelqa
Environment=NODE_ENV=production
EnvironmentFile=/etc/grelqa/scheduler.env
ExecStart=/opt/node/bin/node --import tsx scripts/process-schedule.ts
TimeoutStartSec=5min
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/srv/grelqa/data
StandardOutput=journal
StandardError=journal
